# AirClaw 后端环境变量模板
#
# 使用：复制为 .env 后按内网实际情况填写
#   cd backend && cp .env.example .env
#
# 注意：
#   1. .env 内含凭证，已在 .gitignore 中排除，严禁提交至版本库。
#   2. 系统不内置任何互联网服务地址。以下地址必须全部指向内网已授权服务。
#   3. 运行期不产生任何自动下载行为。

# ============================================================
# 内网私有化模型服务（Agent 主模型）
# 要求：兼容 OpenAI API 格式；推荐 vLLM 或 Ollama 部署
#       经授权的本地化开源模型（DeepSeek-R1 蒸馏版 / Qwen 系列等）
#
# 【本地原型阶段】改指 doc/model.md 中的公网聚合网关。
#   交付前必须换回内网地址，见下方「内网部署」注释块。
# ============================================================
LLM_BASE_URL=https://apihub.agnes-ai.com/v1
LLM_MODEL=agnes-2.5-flash
LLM_API_KEY=sk-REPLACE_WITH_YOUR_AGNES_KEY

# 生成参数
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_REQUEST_TIMEOUT=120

# ============================================================
# 向量模型服务（知识库 & MEMORY.md 检索）
#
# ============================================================
EMBEDDING_PROVIDER=jina
EMBEDDING_BASE_URL=https://api.jina.ai/v1/embeddings
EMBEDDING_API_KEY=REPLACE_WITH_YOUR_JINA_KEY
EMBEDDING_MODEL=jina-embeddings-v5-omni-small
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TASK=retrieval.query

# ------------------------------------------------------------
# 【内网部署时改为】—— 只改上面两块的地址与密钥，代码无需改动
#
# LLM_BASE_URL=http://<内网推理服务地址>/v1
# LLM_MODEL=deepseek-r1-distill-32b
# LLM_API_KEY=<由内网模型服务统一签发>
#
# EMBEDDING_BASE_URL=http://<内网Embedding服务地址>
# EMBEDDING_MODEL=BGE-M3
# EMBEDDING_DIMENSIONS=1024
# ------------------------------------------------------------

# ============================================================
# 服务监听
# ============================================================
APP_HOST=0.0.0.0
APP_PORT=8002
APP_LOG_LEVEL=INFO

# ============================================================
# 操作者身份
#
# 写入审计日志的 user 字段，前端导航栏也显示它。回答的是「这台部署是谁在用」，
# 而不是「这次请求是谁发的」——本项目没有登录体系，客户端上报的身份不被信任。
# 单机多人共用一台部署时它不区分人；需要按人追溯时改这里，或在外层接入认证网关。
# ============================================================
APP_USER=dev01

# ============================================================
# 目录（相对 backend/，留空则使用默认值）
# ============================================================
# AIRCLAW_MEMORY_DIR=memory
# AIRCLAW_SESSIONS_DIR=sessions
# AIRCLAW_SKILLS_DIR=skills
# AIRCLAW_KNOWLEDGE_DIR=knowledge
# AIRCLAW_REPORTS_DIR=reports
# AIRCLAW_AUDIT_DIR=audit
# AIRCLAW_STORAGE_DIR=storage

# ============================================================
# Docker 沙箱
# ============================================================
SANDBOX_IMAGE=airclaw-sandbox:latest
SANDBOX_TIMEOUT=300
SANDBOX_CPUS=2
SANDBOX_MEMORY=2g
SANDBOX_PIDS_LIMIT=256

# ============================================================
# 会话与上下文
# ============================================================
# System Prompt 单个组件文件字符上限，超出截断并标记 ...[truncated]
PROMPT_COMPONENT_MAX_CHARS=20000
# 对话压缩：归档前 N% 的消息
COMPRESS_RATIO=0.5

# ============================================================
# 演示模式 —— 把系统交给别人体验时打开
# ============================================================
# 关闭时（默认）不装任何额外的闸，本机与内网使用不受影响。
# 打开后：所有请求要过一次共享口令、一切写操作被拒、按 IP 限流、
# 且会话按访客 IP 隔离（访客互相看不到对方的对话）。
# 详见 api/demo_guard.py。注意口令走 HTTP Basic——**没有 TLS 时是明文传输**，
# 只挡「链接被转发出去」，不挡链路上抓包。
DEMO_MODE=false
# 共享口令。留空时演示模式会**拒绝所有请求**，而不是变成公开服务
DEMO_PASSWORD=
# 每个访客每小时最多几次对话（0 表示不限）
DEMO_CHAT_PER_HOUR=30
# 单条消息字符上限，防止一条长文把模型额度烧掉一大截
DEMO_MAX_MESSAGE_CHARS=2000
